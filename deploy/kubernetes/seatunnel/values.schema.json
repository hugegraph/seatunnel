{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Optional SeaTunnel engine values",
  "description": "Validate chart-specific constraints; native Kubernetes settings pass through.",
  "type": "object",
  "properties": {
    "mode": { "enum": ["standalone", "cluster"] },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 55,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "clusterDomain": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "required": ["registry", "tag", "pullPolicy"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[a-fA-F0-9]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "master": {
      "type": "object",
      "properties": {
        "replicas": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "not": { "const": 5801 }
        }
      }
    },
    "configMap": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "existingConfigMapName": { "type": "string" },
        "data": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$" },
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "engineConfig": {
      "type": "object",
      "properties": {
        "http": { "type": "object" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "standalone" } } },
      "then": {
        "properties": {
          "master": { "properties": { "replicas": { "enum": [null, 1] } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "configMap": {
            "required": ["create"],
            "properties": { "create": { "const": false } }
          }
        }
      },
      "then": {
        "properties": {
          "configMap": {
            "required": ["existingConfigMapName"],
            "properties": {
              "existingConfigMapName": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}
